# Backend: scripted (deterministic CI), local (OpenAI-compatible endpoint), or hosted.
BACKEND=scripted
HOLO_BASE_URL=http://127.0.0.1:8000/v1
HOLO_MODEL=Hcompany/Holo-3.1-4B
HOLO_MODEL_REVISION=local-checkpoint
HOLO_PROCESSOR_REVISION=local-checkpoint
HOLO_FIXTURE_HOST=127.0.0.1
HOLO_FIXTURE_PORT=8765
HOLO_MAX_STEPS=8
# Required literal acknowledgement before any live desktop capture:
# HOLO_CAPTURE_CONSENT=I_HAVE_ISOLATED_THE_DESKTOP

# Optional command used by `demo holo`; it must launch a disposable browser profile.
# Example on macOS (keep the literal {url} and {profile} placeholders):
# HOLO_BROWSER_COMMAND='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome' --user-data-dir={profile} --new-window {url}

# Never put hosted credentials here in a committed file. Holo CLI reads ~/.holo/.env.
